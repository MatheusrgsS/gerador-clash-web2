<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="CampeonatoPartidasCompleto" language="java"
              pageWidth="595" pageHeight="842"
              columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="b1c2d3e4-f5a6-7890-1234-56789abcdef0">

    <parameter name="CAMPEONATO_ID" class="java.lang.Long"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String">
        <defaultValueExpression><![CDATA["/relatorios/"]]></defaultValueExpression>
    </parameter>
    <parameter name="SUBREPORT_JOGADORES" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>

    <queryString><![CDATA[SELECT
            c.id AS campeonato_id,
            c.nome AS campeonato_nome,
            c.data_inicio AS campeonato_data_inicio,
            c.status AS campeonato_status,
            eq_camp.nome AS campeao_nome,
            p.id AS partida_id,
            p.rodada AS partida_rodada,
            p.data_hora AS partida_data_hora,
            p.placar_mandante,
            p.placar_visitante,
            p.status AS partida_status,
            ar.nome AS arena_nome,
            m.id AS mandante_id,
            m.nome AS mandante_nome,
            m.responsavel AS mandante_tecnico,
            v.id AS visitante_id,
            v.nome AS visitante_nome,
            v.responsavel AS visitante_tecnico,
            venc.nome AS vencedor_nome
        FROM campeonato c
        LEFT JOIN equipe eq_camp ON eq_camp.id = c.campeao_id
        INNER JOIN partida p ON p.campeonato_id = c.id
        LEFT JOIN arena ar ON ar.id = p.arena_id
        INNER JOIN equipe m ON m.id = p.equipe_mandante_id
        INNER JOIN equipe v ON v.id = p.equipe_visitante_id
        LEFT JOIN equipe venc ON venc.id = p.vencedor_id
        WHERE c.id = $P{CAMPEONATO_ID}
        ORDER BY p.rodada ASC, p.id ASC]]></queryString>

    <field name="campeonato_id" class="java.lang.Long"/>
    <field name="campeonato_nome" class="java.lang.String"/>
    <field name="campeonato_data_inicio" class="java.sql.Date"/>
    <field name="campeonato_status" class="java.lang.String"/>
    <field name="campeao_nome" class="java.lang.String"/>
    <field name="partida_id" class="java.lang.Long"/>
    <field name="partida_rodada" class="java.lang.Integer"/>
    <field name="partida_data_hora" class="java.sql.Timestamp"/>
    <field name="placar_mandante" class="java.lang.Integer"/>
    <field name="placar_visitante" class="java.lang.Integer"/>
    <field name="partida_status" class="java.lang.String"/>
    <field name="arena_nome" class="java.lang.String"/>
    <field name="mandante_id" class="java.lang.Long"/>
    <field name="mandante_nome" class="java.lang.String"/>
    <field name="mandante_tecnico" class="java.lang.String"/>
    <field name="visitante_id" class="java.lang.Long"/>
    <field name="visitante_nome" class="java.lang.String"/>
    <field name="visitante_tecnico" class="java.lang.String"/>
    <field name="vencedor_nome" class="java.lang.String"/>

